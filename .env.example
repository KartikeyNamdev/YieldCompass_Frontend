# false = talk to the real backend through the /v1 proxy; true (default) = built-in seed data, no backend needed
NEXT_PUBLIC_DEMO_MODE=false
# leave empty: the app calls its own /v1 and Next proxies it to BACKEND_URL
NEXT_PUBLIC_API_URL=
# public URL of the YieldCompass backend API (server-side only), e.g. https://yc-api.example.com
BACKEND_URL=http://localhost:4000
